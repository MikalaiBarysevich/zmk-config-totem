#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define COLEMAK 1
#define GAME    2
#define NUM     3
#define SYM     4
#define FN      5

// Home-row mods, ported from the QH42 Vial config - this time from the numbers
// actually in it. Read out of ~/qh42-backup/live-after-20261020.vil, decoded
// through the setting ids in vial-gui/src/main/resources/base/qmk_settings.json:
//
//   Tapping Term             (qsid 7)           200
//   Permissive Hold          (qsid 8, bit 0)    on
//   Ignore Mod Tap Interrupt (qsid 8, bit 1)    on
//   Tapping Force Hold       (qsid 8, bit 2)    on
//   Retro Tapping            (qsid 8, bit 3)    off
//
// The 175 that used to stand here was a misread of the backup: that is Auto
// Shift's timeout (qsid 4), and Auto Shift itself was switched off.
//
// Permissive Hold together with Ignore Mod Tap Interrupt is exactly what ZMK
// calls "balanced" - a key tapped inside the hold resolves it at once, while a
// mere interrupting press does not. The old "tap-preferred" had no equivalent
// of Permissive Hold at all, so every home-row chord sat out the whole tapping
// term before the modifier landed. That is up to 175ms of delay per chord that
// Vial never charged, and it is the "unpleasant lag" this config was accused of.
//
// Two properties are deliberately absent rather than set:
//   - quick-tap-ms keeps its default of 0. Tapping Force Hold was on, and that
//     is precisely the absence of tap-then-hold auto-repeat; the 100 here said
//     the opposite.
//   - require-prior-idle-ms has no counterpart in Vial. It was invented during
//     the port, and all it did was paper over the delay above while typing fast,
//     which is why the lag came and went.
&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // D + F -> Tab, as on the QH42.
        combo_tab {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp TAB>;
        };

        // Unlocking ZMK Studio. On a combo rather than its own key: the FN
        // layer has no free slots left, and the two ends of the BT_SEL row
        // are never pressed together by accident.
        combo_studio_unlock {
            timeout-ms = <80>;
            layers = <FN>;
            key-positions = <21 25>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            // The right pinky home-row mod sends LEFT GUI, not right: Windows
            // treats the two as separate keys and a good deal of software only
            // listens for the left one, so shortcuts fired from the right hand
            // silently did nothing there. Every other home-row mod keeps its
            // own side.
            bindings = <
                             &kp Q            &kp W            &kp E            &kp R            &kp T    &kp Y            &kp U            &kp I            &kp O            &kp P
                             &mt LGUI A       &mt LALT S       &mt LCTRL D      &mt LSHFT F      &kp G    &kp H            &mt RSHFT J      &mt RCTRL K      &mt RALT L       &mt LGUI SEMI
   &kp TAB          &kp Z            &kp X            &kp C            &kp V            &kp B    &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH &kp SQT
                                     &kp ESC          &mo 4            &kp SPACE    &kp RET          &mo 3            &kp BSPC
            >;
        };

        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
                             &kp Q            &kp W            &kp F            &kp P            &kp G    &kp J            &kp L            &kp U            &kp Y            &kp SEMI
                             &kp A            &kp R            &kp S            &kp T            &kp D    &kp H            &kp N            &kp E            &kp I            &kp O
   &kp LSHFT        &kp Z            &kp X            &kp C            &kp V            &kp B    &kp K            &kp M            &kp COMMA        &kp DOT          &kp FSLH &kp RSHFT
                                     &kp LGUI         &mo 4            &kp SPACE    &kp RET          &mo 3            &kp RALT
            >;
        };

        game_layer {
            display-name = "GAME";
            bindings = <
                             &kp Q            &kp W            &kp E            &kp R            &kp T    &kp Y            &kp U            &kp I            &kp O            &kp P
                             &kp A            &kp S            &kp D            &kp F            &kp G    &kp H            &kp J            &kp K            &kp L            &kp SEMI
   &kp LCTRL        &kp Z            &kp X            &kp C            &kp V            &kp B    &kp N            &kp M            &kp COMMA        &kp DOT          &kp FSLH &kp RSHFT
                                     &kp LGUI         &mo 4            &kp SPACE    &kp RET          &mo 3            &kp RALT
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
                             &kp N1           &kp N2           &kp N3           &kp N4           &kp N5    &kp N6           &kp N7           &kp N8           &kp N9           &kp N0
                             &none            &none            &kp C_NEXT       &kp C_VOL_UP     &kp C_MUTE    &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp PSCRN
   &kp LSHFT        &none            &none            &kp C_PREV       &kp C_VOL_DN     &kp C_PP    &kp HOME         &kp PG_DN        &kp PG_UP        &kp END          &kp INS &kp RSHFT
                                     &kp LGUI         &mo 5            &kp SPACE    &kp RET          &trans           &kp LALT
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
                             &kp EXCL         &kp AT           &kp HASH         &kp DLLR         &kp PRCNT    &kp CARET        &kp AMPS         &kp STAR         &kp LPAR         &kp RPAR
                             &kp CAPS         &none            &none            &none            &none    &kp GRAVE        &kp MINUS        &kp EQUAL        &kp LBKT         &kp RBKT
   &none            &none            &none            &none            &none            &none    &kp TILDE        &kp UNDER        &kp PLUS         &kp LBRC         &kp RBRC &kp PIPE
                                     &kp LGUI         &trans           &kp SPACE    &kp RET          &trans           &kp DEL
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
                             &kp F1           &kp F2           &kp F3           &kp F4           &kp F5    &kp F6           &kp F7           &kp F8           &kp F9           &kp F10
                             &out OUT_TOG     &kp F11          &kp F12          &to 2            &to 0    &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &mkp MB1
   &bt BT_CLR       &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4    &msc SCRL_LEFT   &msc SCRL_DOWN   &msc SCRL_UP     &msc SCRL_RIGHT  &mkp MB2 &mkp MB3
                                     &kp LGUI         &trans           &kp SPACE    &kp RET          &trans           &kp RCTRL
            >;
        };
    };
};
