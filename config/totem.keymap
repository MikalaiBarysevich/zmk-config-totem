// Mouse keys as fast as on the QH42 (Vial mousekey settings: delta 8 px per
// 20 ms report, max speed x10, 30 reports to reach it -> about 4000 px/s after
// 0.6 s; wheel 1 notch per 80 ms up to 8, reached after 3.2 s -> 100 notches/s).
// ZMK's defaults are 600 px/s after 0.3 s and a flat 10 notches/s. These must
// be defined before pointing.h, which only sets them #ifndef.

#define ZMK_POINTING_DEFAULT_MOVE_VAL 4000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE    0
#define COLEMAK 1
#define GAME    2
#define NUM     3
#define SYM     4
#define FN      5

// Home-row mods, ported from the QH42 Vial config. The numbers below are the
// QH42's live Tap-Hold settings as of 2026-11-05, read off the Vial GUI itself
// rather than a backup file:
//
//   Tapping Term             (qsid 7)           300
//   Permissive Hold          (qsid 8, bit 0)    on
//   Ignore Mod Tap Interrupt (qsid 8, bit 1)    on
//   Tapping Force Hold       (qsid 8, bit 2)    on
//   Retro Tapping            (qsid 8, bit 3)    off
//
// The term stood at 200 here, which was correct for
// ~/qh42-backup/live-after-20261020.vil; it has since been raised on the QH42,
// and the point of this port is that the two boards feel the same. Before that
// it briefly read 175, which was a misread of the same backup - that is Auto
// Shift's timeout (qsid 4), and Auto Shift itself was switched off.
//
// A longer term makes a hold easier to reach deliberately and a tap harder to
// trigger by accident, at the cost of the modifier landing later. With
// "balanced" that cost is only paid for a chord that is held without pressing
// anything else - a chord that does press another key resolves immediately, so
// the 300 is nowhere near 300ms of felt lag while typing.
//
// Permissive Hold together with Ignore Mod Tap Interrupt is exactly what ZMK
// calls "balanced" - a key tapped inside the hold resolves it at once, while a
// mere interrupting press does not. The old "tap-preferred" had no equivalent
// of Permissive Hold at all, so every home-row chord sat out the whole tapping
// term before the modifier landed. That is up to 175ms of delay per chord that
// Vial never charged, and it is the "unpleasant lag" this config was accused of.
//
// quick-tap-ms: tap a home-row key, then press and hold it again within
// 300 ms, and it auto-repeats the letter instead of becoming the modifier.
// That is how the QH42 actually behaved (user-verified, 2026-11-06), even
// though Vial showed Tapping Force Hold on - KMK's HoldTap repeats the tap
// within tap_time, so 300 = the tapping term, as there.
//
// One property is deliberately absent rather than set:
//   - require-prior-idle-ms has no counterpart in Vial. It was invented during
//     the port, and all it did was paper over the delay above while typing fast,
//     which is why the lag came and went.

&mmv { time-to-max-speed-ms = <600>; };

&msc { time-to-max-speed-ms = <3200>; };

&mt {
    flavor = "balanced";
    tapping-term-ms = <300>;
    quick-tap-ms = <300>;
};

// ZMK's stock &gresc is a mod-morph with no keep-mods, and a mod-morph strips
// the modifier that triggered it. So Shift+Esc sent a bare GRAVE (`) instead of
// TILDE (~). Keeping the shift mods restores the behaviour everyone expects.
// GUI is deliberately left out: GUI+Esc keeps sending a plain `, and the host
// never sees GUI+grave, which is a window-switching shortcut on some desktops.

&gresc { keep-mods = <(MOD_LSFT|MOD_RSFT)>; };

/ {
    combos {
        compatible = "zmk,combos";

        // D + F -> Tab, as on the QH42.

        combo_tab {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp TAB>;
        };

        // Unlocking ZMK Studio. On a combo rather than its own key: the FN
        // layer has no free slots left, and the two ends of the BT_SEL row
        // are never pressed together by accident.

        combo_studio_unlock {
            timeout-ms = <80>;
            layers = <FN>;
            key-positions = <21 25>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";

            // The right pinky home-row mod sends LEFT GUI, not right: Windows
            // treats the two as separate keys and a good deal of software only
            // listens for the left one, so shortcuts fired from the right hand
            // silently did nothing there. Every other home-row mod keeps its
            // own side.

            bindings = <
           &kp Q       &kp W       &kp E        &kp R        &kp T        &kp Y    &kp U        &kp I        &kp O       &kp P
           &mt LGUI A  &mt LALT S  &mt LCTRL D  &mt LSHFT F  &kp G        &kp H    &mt RSHFT J  &mt RCTRL K  &mt RALT L  &mt LGUI SEMI
&kp GRAVE  &kp Z       &kp X       &kp C        &kp V        &kp B        &kp N    &kp M        &kp COMMA    &kp DOT     &kp FSLH       &kp SQT
                                   &kp ESC      &mo 4        &kp SPACE    &kp RET  &mo 3        &kp BSPC
            >;
        };

        colemak_layer {
            display-name = "COLEMAK";
            bindings = <
           &kp Q  &kp W  &kp F     &kp P  &kp G        &kp J    &kp L  &kp U      &kp Y    &kp SEMI
           &kp A  &kp R  &kp S     &kp T  &kp D        &kp H    &kp N  &kp E      &kp I    &kp O
&kp LSHFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp K    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LGUI  &mo 4  &kp SPACE    &kp RET  &mo 3  &kp RALT
            >;
        };

        game_layer {
            display-name = "GAME";
            bindings = <
           &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y    &kp U  &kp I      &kp O    &kp P
           &kp A  &kp S  &kp D     &kp F  &kp G        &kp H    &kp J  &kp K      &kp L    &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N    &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
                         &kp LGUI  &mo 4  &kp SPACE    &kp RET  &mo 3  &kp RALT
            >;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
           &kp N1    &kp N2    &kp N3            &kp N4              &kp N5        &kp N6    &kp N7     &kp N8         &kp N9     &kp N0
           &kp LGUI  &kp LALT  &mt LCTRL C_NEXT  &mt LSHFT C_VOL_UP  &kp C_MUTE    &kp LEFT  &kp DOWN   &kp UP         &kp RIGHT  &kp PSCRN
&kp LSHFT  &none     &none     &kp C_PREV        &kp C_VOL_DN        &kp C_PP      &kp HOME  &kp PG_DN  &kp PG_UP      &kp END    &kp INS    &kp RSHFT
                               &kp LGUI          &mo 5               &kp SPACE     &kp RET   &trans     &kp BACKSPACE
            >;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
       &kp EXCL       &kp AT    &kp HASH   &kp DLLR       &kp PRCNT    &kp CARET  &kp AMPS   &kp STAR   &kp LPAR  &kp RPAR
       &mt LGUI CAPS  &kp LALT  &kp LCTRL  &mt LSHFT SQT  &kp BSLH     &kp GRAVE  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT
&none  &none          &none     &none      &none          &kp PIPE     &kp TILDE  &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                                &none      &trans         &none        &none      &trans     &none
            >;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
            &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &kp F6          &kp F7          &kp F8        &kp F9           &kp F10
            &out OUT_TOG  &kp F11       &kp F12       &to 2         &to 0           &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &mkp MB1
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &mkp MB2  &mkp MB3
                                        &none         &trans        &none           &none           &trans          &none
            >;
        };
    };
};
